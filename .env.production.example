# Environment for the production Docker Compose stack (docker-compose.prod.yml).
# Copy to .env.production and replace every "change-me" with a real secret.
# Generate APP_KEY with: php artisan key:generate --show

APP_NAME=Laravel
APP_ENV=production
APP_DEBUG=false
APP_KEY=change-me
APP_URL=http://localhost:8000

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=poepricer
DB_USERNAME=poepricer
DB_PASSWORD=change-me

POSTGRES_DB=poepricer
POSTGRES_USER=poepricer
POSTGRES_PASSWORD=change-me

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me

CACHE_STORE=redis
SESSION_DRIVER=database
QUEUE_CONNECTION=redis
