# Environment for the Docker Compose stack.
# Copy to .env.docker and replace every "change-me" with a real secret.
# These values are injected into the containers as real environment variables,
# so they take precedence over the values in Laravel's .env.

APP_NAME=Laravel
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=poepricer
DB_USERNAME=poepricer
DB_PASSWORD=change-me

POSTGRES_DB=poepricer
POSTGRES_USER=poepricer
POSTGRES_PASSWORD=change-me

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me

CACHE_STORE=redis
SESSION_DRIVER=database
QUEUE_CONNECTION=database
